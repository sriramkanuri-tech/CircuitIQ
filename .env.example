# CircuitIQ Environment Variables

# Public Supabase API credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Server-only Credentials (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
RESEND_API_KEY=re_your_resend_api_key_here

# App URL for QR Verification & Email Links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gmail SMTP Configuration (CircuitIQ Email Dispatcher)
GMAIL_USER=your-smtp-gmail@gmail.com
GMAIL_APP_PASSWORD=your-google-app-password
SMTP_FROM_NAME=CircuitIQ
SMTP_FROM_EMAIL=CircuitIQ@gmail.com
